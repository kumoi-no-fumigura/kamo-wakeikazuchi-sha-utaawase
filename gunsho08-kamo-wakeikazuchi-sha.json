 "poems": [
  {
   "seq": "1",
   "text": "雲井より秋風わけし雁金の歸るなみちは霞なりけり",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "馴てしもよゝの秋かせこしの海のかへるなみたに雁そ鳴なる",
   "kana": "",
   "speaker": "",
   "page": 208,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "今はとて鳴てや雁も歸るらんなにはのうらの明ほのゝ空",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "秋の空きり飛わけてこしの海の浪にかすみて歸る雁かね",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "しほるらん春のなみ路をゆく雁のつはさ吹ほせやへのしほ風",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "浦にたくもしほの烟立わかれ霞のなみにかへる雁かね",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "歸る雁遠さかり行すゑの松まつに名殘の浪はかけつゝ",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "遠さかる雲ゐの雁の名殘まてかずめるつらきなには江の月",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "三芳野や春雨きをひちる花を今日もくれぬとさそふ山風",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "あふ坂の杉の木間をもる雨のしつくにやとる春の山人",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "我袖よぬれてやとかるならひがなしくれし山の春の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "春とてもたれかみ山の槇の葉にとふもさひしき夕暮の雨",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "いはねふみ歸る山人いかゝするはるさめそゝくたそかれの空",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "御吉野や花にくらせる山の奥に雨はふりきぬ道ふかくして",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "これも又いそくか秋のたつた山木のめ春雨降くらしつゝ",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "けふの日もむなしき山にすきの葉の下吹かせになひく春雨",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "春雨にぬれたる花のしほれても歸るはつらき山のゆふ暮",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "霜かれのゝなる草木のめもはるに雨ふりくらすきさらきの山",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "かすみたにふかき山路となかめつる峯にゆふゐる春雨の雲",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "わかの浦たむくる夜半の風にこそ猶此みちに神もなひかめ",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "さかきとるやそうち人の袖のうへにかをとめてふく春夜の風",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "いかにせん神もおもはし人もいはす夜吹風をしてにきけとは",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "鐘の音もほのかにふけぬ神山の花のほかまてさそふ嵐に",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "かすむ夜の月をあかすやみたらしのきよき河せをあらふ春風",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "かも山の月のかつらの木間より神さひわたるみたらしの風",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "見すしらぬその神山の神代まてかよふ夢ちをとふあらし哉",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "雲わけて君を八千代とまもるらし風靜なる神山の月",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "神かきやして吹風のよをかさね誰かは君の千世を祈らん",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "さかきとるしてに嵐の音さえて袖にもあくる春夜の月",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "馴そめしその神山の夜半の嵐ちらぬたのみをまつにつく也",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "かも山や仰ける御代のためしとやのとけきかせに雲もなき月",
   "kana": "",
   "speaker": "",
   "page": 209,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
